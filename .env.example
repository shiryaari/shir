# סוד לחתימת הקישורים האישיים (מחרוזת אקראית ארוכה)
SIGNING_SECRET=change-me-to-a-long-random-string
# כתובות ה-Webhook ב-Make. אם ריק, האירועים רק מודפסים ללוג.
# ההרשמה: ה-webhook של הסנריו הקיים "Talexa - נרשמת חדשה (בזמן אמת)" (אותו מבנה, אין שינוי בסנריו)
MAKE_REGISTRATION_WEBHOOK_URL=
# אירועי החדר: ה-webhook "וובינר אוטומטי חדש - אירועי החדר"
MAKE_EVENTS_WEBHOOK_URL=
# אפשרות חלופית: כתובת אחת לשניהם
MAKE_WEBHOOK_URL=
# כתובת האתר של החדר, למשל https://webinar.your-domain.co.il (אם ריק מחושב אוטומטית)
SITE_URL=
# דומיינים שמורשים לשלוח הרשמה (דף הנחיתה שלך), מופרדים בפסיק. * = הכול
ALLOWED_ORIGINS=*
