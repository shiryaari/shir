# סוד לחתימת הקישורים האישיים (מחרוזת אקראית ארוכה)
SIGNING_SECRET=change-me-to-a-long-random-string
# כתובת ה-Webhook מ-Make (Custom webhook). אם ריק, האירועים רק מודפסים ללוג.
MAKE_WEBHOOK_URL=
# כתובת האתר של החדר, למשל https://webinar.your-domain.co.il (אם ריק מחושב אוטומטית)
SITE_URL=
# דומיינים שמורשים לשלוח הרשמה (דף הנחיתה שלך), מופרדים בפסיק. * = הכול
ALLOWED_ORIGINS=*
